<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MisClaves.Views.AcercaDePage"
             Title="Acerca de">

    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">

        <Label Text="MisClaves"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="{StaticResource Accent}"
               HorizontalOptions="Center" />

        <Label x:Name="VersionLabel"
               FontSize="14"
               TextColor="{StaticResource TextSecondary}"
               HorizontalOptions="Center" />

        <BoxView HeightRequest="1"
                 BackgroundColor="{StaticResource SurfaceLight}"
                 Margin="0,10" />

        <Label Text="MisClaves es un gestor de contraseñas local: guarda tus credenciales (URL, usuario, contraseña y comentarios) cifradas en tu propio dispositivo, protegidas por una contraseña maestra que solo vos conocés. Ningún dato se envía a servidores externos."
               FontSize="15"
               LineBreakMode="WordWrap"
               HorizontalTextAlignment="Center" />

        <Label Text="Desarrollado por Itterrep"
               FontSize="13"
               TextColor="{StaticResource TextSecondary}"
               HorizontalOptions="Center"
               Margin="0,20,0,0" />

    </VerticalStackLayout>
</ContentPage>