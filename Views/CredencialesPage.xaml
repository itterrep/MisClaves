<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MisClaves.Views.CredencialesPage"
             Title="Mis Claves">

    <!--<ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="aboutas_bw.png"
                     Text="Acerca de"
                     Clicked="OnAcercaDeClicked" />
    </ContentPage.ToolbarItems>-->

    <Grid RowDefinitions="*, Auto">

        <CollectionView x:Name="CredencialesList"
                         Grid.Row="0"
                         SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="15,10" ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0"
                                             HorizontalOptions="FillAndExpand">
                            <Label Text="{Binding Url}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Usuario}" FontSize="14" TextColor="Gray" />
                        </VerticalStackLayout>

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCredencialTapped"
                                                   CommandParameter="{Binding Id}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1"
                Text="+ Agregar credencial"
                Margin="15"
                Clicked="OnAgregarClicked" />

    </Grid>
</ContentPage>