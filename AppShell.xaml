<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MisClaves.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MisClaves.Views"
    Shell.BackgroundColor="{StaticResource Turquoise}"
    Shell.ForegroundColor="{StaticResource Black}"
    Shell.TitleColor="{StaticResource Black}"
    Shell.UnselectedColor="{StaticResource Black}"
